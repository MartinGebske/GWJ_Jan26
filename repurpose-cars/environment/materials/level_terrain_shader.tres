code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 var_normal;

uniform float brightness = 1.0;
uniform vec4 ColorParameter : source_color;
uniform sampler2D RockTexture;
uniform sampler2D tex_frg_4;
uniform sampler2D tex_frg_9;



void vertex() {
// Input:2
	vec3 n_out2p0 = NORMAL;


// VaryingSetter:3
	var_normal = n_out2p0;


}

void fragment() {
// FloatParameter:17
	float n_out17p0 = brightness;


// ColorParameter:15
	vec4 n_out15p0 = ColorParameter;


// UVFunc:16
	vec2 n_in16p1 = vec2(10.00000, 10.00000);
	vec2 n_in16p2 = vec2(0.00000, 0.00000);
	vec2 n_out16p0 = (UV - n_in16p2) * n_in16p1 + n_in16p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(RockTexture, n_out16p0);


// Mix:14
	vec3 n_in14p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out14p0 = mix(vec3(n_out15p0.xyz), vec3(n_out3p0.xyz), n_in14p2);


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, n_out16p0);


// VaryingGetter:5
	vec3 n_out5p0 = var_normal;
	float n_out5p2 = n_out5p0.g;


// FloatOp:7
	float n_in7p1 = -0.60000;
	float n_out7p0 = n_out5p2 + n_in7p1;


// FloatOp:8
	float n_in8p1 = 4.00000;
	float n_out8p0 = n_out7p0 * n_in8p1;


// Clamp:6
	float n_in6p1 = 0.00000;
	float n_in6p2 = 1.00000;
	float n_out6p0 = clamp(n_out8p0, n_in6p1, n_in6p2);


// Mix:2
	vec3 n_out2p0 = mix(n_out14p0, vec3(n_out4p0.xyz), vec3(n_out6p0));


// VectorOp:18
	vec3 n_out18p0 = vec3(n_out17p0) * n_out2p0;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, UV);


// Mix:10
	vec3 n_in10p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out10p0 = mix(vec3(n_out9p0.xyz), n_in10p1, n_out2p0);


// Output:0
	ALBEDO = n_out18p0;
	NORMAL = n_out10p0;


}
"
